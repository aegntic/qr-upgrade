{
  "name": "qr-upgrade",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3017",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3017",
    "typecheck": "tsc --noEmit",
    "marketing:check": "node scripts/marketing/watch.mjs",
    "test": "tsx --test tests/*.test.ts",
    "security:evidence": "node scripts/security/collect.mjs",
    "compliance:release": "node scripts/security/release.mjs",
    "security:http": "node scripts/security/http-check.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false cloudflare-env.d.ts",
    "security:cloudflare": "node scripts/security/cloudflare-check.mjs",
    "higgsfield:example": "tsx examples/higgsfield/index.ts"
  },
  "dependencies": {
    "@higgsfield/client": "0.2.6",
    "fflate": "0.8.3",
    "jose": "6.2.12",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "lucide-react": "1.47.0",
    "next": "15.5.25",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "fake-indexeddb": "^6.2.5",
    "rclone.js": "0.6.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "wrangler": "4.135.0"
  },
  "overrides": {
    "postcss": "8.5.28",
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
