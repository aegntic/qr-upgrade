# The browser editor is fully local and does not need this API.
# Provision through the deployment secret manager. Never use NEXT_PUBLIC_* for credentials.
SCAN_API_ENABLED=false
SCAN_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Worker service, server-side only. Provision through secret managers.
QR_SERVICE_URL=
QR_SERVICE_SECRET=
