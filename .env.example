# The browser editor is fully local and does not need this API.
# Provision through the deployment secret manager. Never use NEXT_PUBLIC_* for credentials.
SCAN_API_ENABLED=false
SCAN_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Worker service, server-side only. Provision through secret managers.
QR_SERVICE_URL=
QR_SERVICE_SECRET=
# Optional art POST origin. Leave unset for https://qrupgrade.com; staging may set the exact private preview origin.
# QR_ART_ORIGIN=https://preview.qrupgrade.com

# Stripe billing, server-side only. Keep disabled until every value is provisioned and reviewed.
BILLING_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BRAND=
# Dedicated QR Upgrade Customer Portal configuration (bpc_...), never the account default.
STRIPE_PORTAL_CONFIGURATION=

ACCOUNT_ORIGIN=
