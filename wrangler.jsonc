{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qr-upgrade-web",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "observability": { "enabled": false },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true },
  "services": [{ "binding": "QR_SERVICE", "service": "qr-upgrade-service" }],
  "ratelimits": [{ "name": "API_RATE_LIMITER", "namespace_id": "2026092001", "simple": { "limit": 120, "period": 60 } }]
}
